<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.user.siglip-spur</string>
  <!-- SigLIP-Spur fuer alle Quellen nachrechnen (scripts/siglip-spur-nachrechnen.py,
       docs/siglip-spur-design.md Schritt 2). KEIN Zeitplan: gestartet per
       `launchctl kickstart gui/501/com.user.siglip-spur` (ohne -k).

       Eigener Dienst aus demselben Grund wie com.user.ocr-spur: ein
       Hintergrund-Kind eines anderen Jobs stirbt mit dessen Prozessgruppe.
       Fortsetzbar: ein erneuter Start rechnet nur, was fehlt oder dessen
       Quelle sich geaendert hat. Eigene venv (torch/transformers), damit der
       Nightly unberuehrt bleibt. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/simon/ml/siglip-exp/.venv/bin/python</string>
    <string>/Users/simon/src/tv-detect/scripts/siglip-spur-nachrechnen.py</string>
  </array>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key>
  <string>/Users/simon/Library/Logs/siglip-spur.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/simon/Library/Logs/siglip-spur.log</string>
</dict>
</plist>
