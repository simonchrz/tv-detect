<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DETECT_PARALLEL</key>
		<string>2</string>
		<key>GATEWAY</key>
		<string>https://raspberrypi5lan:8443</string>
		<key>SOURCE_CACHE_MAX_GB</key>
		<string>1700</string>
		<key>SPEAKER_ENABLE</key>
		<string>1</string>
		<key>SPEAKER_WEIGHT</key>
		<string>0.3</string>
		<key>WHISPER_TRANSCRIBE</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.user.tv-thumbs-daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/python3.13</string>
		<string>/Users/simon/bin/tv-thumbs-daemon.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/simon/Library/Logs/tv-thumbs-daemon.log</string>
	<key>StandardOutPath</key>
	<string>/Users/simon/Library/Logs/tv-thumbs-daemon.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
