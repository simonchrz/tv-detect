<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>DETECT_PARALLEL</key>
		<string>3</string>
		<key>GATEWAY</key>
		<string>https://raspberrypi5lan:8443</string>
		<key>SOURCE_CACHE_MAX_GB</key>
		<string>1700</string>
		<key>SPEAKER_ENABLE</key>
		<string>1</string>
		<key>SPEAKER_WEIGHT</key>
		<string>0.3</string>
		<key>WHISPER_TRANSCRIBE</key>
		<string>1</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.user.tv-thumbs-daemon</string>
	<key>ProgramArguments</key>
	<array>
		<!-- 2026-07-18: the 07-13 /usr/bin/env DETECT_PARALLEL=3 wrapper
		     was removed after a user-run bootout+bootstrap finally went
		     through and confirmed the EnvironmentVariables dict above is
		     honored again (launchctl print shows 3; the earlier silent
		     bootout no-ops never got a root cause). If launchd ever holds
		     a stale env dict again: bootout+bootstrap from an interactive
		     shell, NOT kickstart -k (which reuses the cached job
		     definition wholesale, ProgramArguments included). -->
		<string>/opt/homebrew/bin/python3.13</string>
		<string>/Users/simon/bin/tv-thumbs-daemon.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/simon/Library/Logs/tv-thumbs-daemon.log</string>
	<key>StandardOutPath</key>
	<string>/Users/simon/Library/Logs/tv-thumbs-daemon.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
